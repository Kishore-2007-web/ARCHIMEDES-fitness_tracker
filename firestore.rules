rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Deny all by default
    match /{document=**} {
      allow read, write: if false;
    }

    // User document and all private subcollections
    match /users/{userId} {
      // Only the authenticated owner can read their profile
      allow read: if request.auth != null && request.auth.uid == userId;

      // Allow owner to create initial profile and update allowed fields (settings, onboarding, baseline, title)
      allow create: if request.auth != null && request.auth.uid == userId;
      allow update: if request.auth != null && request.auth.uid == userId;
      allow delete: if request.auth != null && request.auth.uid == userId;

      // Active workout sessions (in-progress logging)
      match /activeSessions/{dateKey} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // Finalized completed sessions (immutable audit record)
      match /sessions/{sessionId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        // Created either by Cloud Function admin or authenticated client fallback
        allow create: if request.auth != null && request.auth.uid == userId;
        allow update, delete: if false; // Immutable once written
      }

      // Exercise historical records
      match /exerciseRecords/{recordId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // Measurements checkpoints
      match /measurements/{measurementId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // Progress checkpoints (Day 1, 30, 60, 90, 124)
      match /progressCheckpoints/{checkpointId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // Achievements
      match /achievements/{achievementId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // Boss Quests
      match /bosses/{bossId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // Rewards
      match /rewards/{rewardId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // System Events Feed
      match /events/{eventId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // Reports (Weekly & Milestone)
      match /reports/{reportId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }
  }
}
